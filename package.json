{
  "name": "tauira",
  "version": "1.0.0",
  "private": true,
  "description": "Tauira — rhizomatic educator-researcher site",
  "scripts": {
    "prebuild": "node scripts/regenerate-graph.js",
    "build": "hugo --minify",
    "serve": "hugo server --navigateToChanged",
    "graph": "node scripts/regenerate-graph.js",
    "validate": "ajv validate -s tauira-schema.json -d \"data/nodes/*.json\" --errors=json && ajv validate -s tauira-schema.json -d \"data/edges/*.json\" --errors=json",
    "build:louvain": "esbuild node_modules/graphology-communities-louvain/index.js --bundle --minify --global-name=louvain --outfile=static/dist/graphology-communities-louvain.min.js"
  },
  "dependencies": {
    "graphology": "^0.25.x",
    "graphology-layout": "^0.6.x",
    "graphology-layout-forceatlas2": "^0.10.x",
    "sigma": "^3.x"
  },
  "devDependencies": {
    "ajv-cli": "5.0.0",
    "esbuild": "^0.20.0"
  }
}
