{
  "name": "tauira",
  "version": "1.0.0",
  "private": true,
  "description": "Tauira — rhizomatic educator-researcher site",
  "scripts": {
    "prebuild": "node scripts/regenerate-graph.js",
    "build": "hugo --minify",
    "serve": "hugo server --navigateToChanged",
    "graph": "node scripts/regenerate-graph.js",
    "validate": "ajv validate -s tauira-schema.json -d \"data/nodes/*.json\" --errors=json && ajv validate -s tauira-schema.json -d \"data/edges/*.json\" --errors=json"
  },
  "dependencies": {
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "sigma": "3.0.2"
  },
  "devDependencies": {
    "ajv-cli": "5.0.0"
  }
}
